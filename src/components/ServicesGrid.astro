---
import { getImage } from "astro:assets";
import { services } from "../data/services";

const optimizedImages = await Promise.all(
	services.map((service) =>
		getImage({ src: service.image, width: 1600, format: "webp", quality: 90 })
	)
);
---

<div class="max-w-360 mx-auto">
	<div class="flex flex-wrap justify-center">
		{services.map((service, index) => (
			<div class="w-1/2 sm:w-1/2 md:w-1/3 lg:w-1/4 min-w-0 box-border p-1.5 sm:p-2.5">
				<div class="service-card h-full">
					<svg viewBox="0 0 24 24" fill="none" class="w-6 h-6 sm:w-9 sm:h-9 stroke-[#395B7A] stroke-[1.6]" set:html={service.icon} />
					<h3 class="service-card-title">{service.title}</h3>
					<p class="hidden sm:block text-sm sm:text-base leading-relaxed text-[#2B2B2B]">{service.desc}</p>
					<button
						type="button"
						class="service-card-btn"
						data-title={service.title}
						data-desc={service.longDesc}
						data-image={optimizedImages[index].src}
					>
						Más info
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
					</button>
				</div>
			</div>
		))}
	</div>
</div>

<div id="service-modal-overlay" class="service-modal-overlay hidden">
	<div class="service-modal" role="dialog" aria-modal="true" aria-labelledby="service-modal-title">
		<button type="button" class="service-modal-close" id="service-modal-close" aria-label="Cerrar">✕</button>
		<img id="service-modal-image" class="service-modal-image" src="" alt="" />
		<div class="service-modal-body">
			<h3 id="service-modal-title" class="service-modal-title"></h3>
			<div id="service-modal-desc" class="service-modal-desc"></div>
		</div>
	</div>
</div>

<div id="image-lightbox" class="image-lightbox hidden">
	<img id="image-lightbox-image" src="" alt="" />
</div>

<script>
	const overlay = document.getElementById("service-modal-overlay");
	const modalImage = document.getElementById("service-modal-image") as HTMLImageElement | null;
	const modalTitle = document.getElementById("service-modal-title");
	const modalDesc = document.getElementById("service-modal-desc");
	const lightbox = document.getElementById("image-lightbox");
	const lightboxImage = document.getElementById("image-lightbox-image") as HTMLImageElement | null;

	const preloadedImages = new Map<string, HTMLImageElement>();
	function preloadImage(src: string) {
		if (!src || preloadedImages.has(src)) return;
		const img = new Image();
		img.src = src;
		preloadedImages.set(src, img);
		img.decode?.().catch(() => {});
	}

	const serviceButtons = document.querySelectorAll<HTMLButtonElement>(".service-card-btn");

	if ("IntersectionObserver" in window) {
		const preloadObserver = new IntersectionObserver(
			(entries, observer) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					const btn = entry.target as HTMLButtonElement;
					preloadImage(btn.dataset.image ?? "");
					observer.unobserve(btn);
				});
			},
			{ rootMargin: "100px" }
		);
		serviceButtons.forEach((btn) => preloadObserver.observe(btn));
	} else {
		serviceButtons.forEach((btn) => preloadImage(btn.dataset.image ?? ""));
	}

	function lockBodyScroll() {
		document.body.style.overflow = "hidden";
	}
	function unlockBodyScroll() {
		document.body.style.overflow = "";
	}

	serviceButtons.forEach((btn) => {
		btn.addEventListener("click", () => {
			if (modalImage) {
				modalImage.src = btn.dataset.image ?? "";
				modalImage.alt = btn.dataset.title ?? "";
			}
			if (modalTitle) modalTitle.textContent = btn.dataset.title ?? "";
			if (modalDesc) {
				modalDesc.innerHTML = "";
				(btn.dataset.desc ?? "").split("\n\n").forEach((paragraph) => {
					const p = document.createElement("p");
					p.textContent = paragraph;
					modalDesc.appendChild(p);
				});
			}
			overlay?.classList.remove("hidden");
			lockBodyScroll();
		});
	});

	document.getElementById("service-modal-close")?.addEventListener("click", () => {
		overlay?.classList.add("hidden");
		unlockBodyScroll();
	});
	overlay?.addEventListener("click", (e) => {
		if (e.target === overlay) {
			overlay.classList.add("hidden");
			unlockBodyScroll();
		}
	});

	modalImage?.addEventListener("click", () => {
		if (lightboxImage && modalImage.src) {
			lightboxImage.src = modalImage.src;
			lightboxImage.alt = modalImage.alt;
			lightbox?.classList.remove("hidden");
		}
	});

	lightbox?.addEventListener("click", () => {
		lightbox?.classList.add("hidden");
	});

	document.addEventListener("keydown", (e) => {
		if (e.key !== "Escape") return;
		if (lightbox && !lightbox.classList.contains("hidden")) {
			lightbox.classList.add("hidden");
		} else {
			overlay?.classList.add("hidden");
			unlockBodyScroll();
		}
	});
</script>
