---
const address = "Calle Marqués de San Juan, 8, 46015 Valencia";
const mapEmbedSrc = `https://www.google.com/maps?q=${encodeURIComponent(address)}&output=embed`;
const directionsHref = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(address)}`;
---

<div class="mx-auto grid max-w-360 items-stretch gap-8 lg:gap-10 lg:grid-cols-[42fr_58fr]">
	<div class="flex flex-col justify-center gap-5 sm:gap-6">
		<div>
			<div class="section-eyebrow text-sm sm:text-base">Encuéntranos</div>
			<h2 class="section-title text-2xl sm:text-3xl lg:text-[42px]">Visítanos en nuestro taller</h2>
		</div>

		<div class="flex flex-col gap-4 sm:gap-4.5">
			<div class="flex items-start gap-3 sm:gap-3.5">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#801A0B" stroke-width="1.8" class="mt-0.5 h-5 w-5 shrink-0"><path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
				<div>
					<div class="font-sans font-bold text-sm sm:text-[15px] text-[#22233A]">Marqués de San Juan, 8 - bajo</div>
					<div class="font-sans text-xs sm:text-sm text-[#2B2B2B] opacity-75">46015 Valencia</div>
				</div>
			</div>

			<div class="flex items-start gap-3 sm:gap-3.5">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#801A0B" stroke-width="1.8" class="mt-0.5 h-5 w-5 shrink-0"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
				<div>
					<div class="font-sans font-bold text-sm sm:text-[15px] text-[#22233A]">Lunes a Viernes: 8:00–13:30 / 15:30–19:00</div>
					<div class="font-sans text-xs sm:text-sm text-[#2B2B2B] opacity-75">Sábado y domingo: cerrado</div>
				</div>
			</div>
		</div>

		<a href={directionsHref} target="_blank" rel="noopener noreferrer" class="btn-primary w-fit text-sm">
			Cómo llegar
		</a>
	</div>

	<div class="min-h-64 sm:min-h-80 lg:min-h-96 overflow-hidden rounded-xl border border-[#395B7A]/14 shadow-[0_10px_30px_rgba(34,35,58,0.2)]">
		<iframe
			src={mapEmbedSrc}
			width="100%"
			height="100%"
			style="border:0; min-height: 260px;"
			allowfullscreen
			loading="lazy"
			referrerpolicy="no-referrer-when-downgrade"
			title="Ubicación de Talleres C.O.D.A en el mapa"
		></iframe>
	</div>
</div>
