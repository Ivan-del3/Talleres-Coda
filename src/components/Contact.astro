<div class="mx-auto max-w-360">
	<div class="mx-auto mb-8 sm:mb-14 max-w-180 text-center">
		<div class="mb-2 sm:mb-3 text-sm sm:text-base font-semibold uppercase tracking-[0.18em] text-[#66bbfe]">Contacto</div>
		<h2 class="section-title text-2xl sm:text-3xl lg:text-[42px] text-[#FEFEFE]">Hablemos de su vehículo</h2>
		<p class="mt-3 sm:mt-4 text-sm sm:text-lg leading-relaxed text-[#FEFEFE]/80">
			Pida cita previa, resuelva una duda o pídanos presupuesto.
		</p>
	</div>

	<div class="grid gap-6 lg:gap-10 lg:grid-cols-[42fr_58fr]">
		<div class="flex flex-col gap-3 sm:gap-4.5">
			<div class="contact-info-card">
				<div class="contact-info-icon">
					<svg viewBox="0 0 24 24" fill="none" stroke="#66bbfe" stroke-width="1.8" class="w-4.5 h-4.5 sm:w-5.5 sm:h-5.5"><path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
				</div>
				<div>
					<div class="font-sans font-bold text-xs sm:text-base text-[#FEFEFE]">Marqués de San Juan, 8 - bajo</div>
					<div class="font-sans text-[11px] sm:text-[15px] text-[#FEFEFE]/75">46015 Valencia</div>
				</div>
			</div>

			<div class="contact-info-card">
				<div class="contact-info-icon">
					<svg viewBox="0 0 24 24" fill="none" stroke="#66bbfe" stroke-width="1.8" class="w-4.5 h-4.5 sm:w-5.5 sm:h-5.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
				</div>
				<div>
					<div class="font-sans font-bold text-xs sm:text-base text-[#FEFEFE]">963 47 47 51 <span class="font-normal opacity-60">/ 695 53 80 78</span></div>
					<div class="font-sans text-[11px] sm:text-[15px] text-[#FEFEFE]/75">coda@tallerescoda.com</div>
				</div>
			</div>

			<div class="contact-info-card">
				<div class="contact-info-icon">
					<svg viewBox="0 0 24 24" fill="none" stroke="#66bbfe" stroke-width="1.8" class="w-4.5 h-4.5 sm:w-5.5 sm:h-5.5"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
				</div>
				<div>
					<div class="font-sans font-bold text-xs sm:text-base text-[#FEFEFE]">Lunes a Viernes: 8:00–13:30 / 15:30–19:00</div>
					<div class="font-sans text-[11px] sm:text-[15px] text-[#FEFEFE]/75">Sábado y domingo: cerrado</div>
				</div>
			</div>

			<div class="mt-1.5 flex">
				<a href="tel:963474751" class="btn-primary w-full sm:w-fit text-center text-sm sm:text-base px-4 py-2 sm:px-5 sm:py-2.5">Llamar Ahora</a>
			</div>
		</div>

		<div class="rounded-2xl bg-[#FEFEFE] px-4 py-5 sm:px-8 sm:py-8 lg:px-11 lg:py-10 shadow-[0_24px_60px_rgba(0,0,0,0.28)]">
			<div class="section-eyebrow mb-1.5 sm:mb-2 text-xs sm:text-base">Formulario de contacto</div>
			<h3 class="font-heading mb-3 sm:mb-5.5 text-base sm:text-xl font-semibold uppercase tracking-[0.02em] text-[#22233A]">Solicite su cita</h3>

			<form class="flex flex-col gap-3 sm:gap-4">
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
					<label class="font-sans font-semibold flex flex-col gap-1 sm:gap-1.5 text-xs sm:text-sm text-[#395B7A]">
						Su nombre:
						<input type="text" name="nombre" placeholder="Nombre y apellidos" class="font-sans rounded-md border-[1.5px] border-[#395B7A]/25 bg-[#FEFEFE] px-3 py-2.5 sm:px-3.5 sm:py-3.5 text-sm sm:text-[15px] text-[#22233A] outline-none placeholder:text-[#22233A]/40" />
					</label>
					<label class="font-sans font-semibold flex flex-col gap-1 sm:gap-1.5 text-xs sm:text-sm text-[#395B7A]">
						Teléfono:
						<input type="tel" name="telefono" placeholder="600 000 000" class="font-sans rounded-md border-[1.5px] border-[#395B7A]/25 bg-[#FEFEFE] px-3 py-2.5 sm:px-3.5 sm:py-3.5 text-sm sm:text-[15px] text-[#22233A] outline-none placeholder:text-[#22233A]/40" />
					</label>
				</div>

				<label class="font-sans font-semibold flex flex-col gap-1 sm:gap-1.5 text-xs sm:text-sm text-[#395B7A]">
					Correo electrónico:
					<input type="email" name="email" placeholder="usted@email.com" class="font-sans rounded-md border-[1.5px] border-[#395B7A]/25 bg-[#FEFEFE] px-3 py-2.5 sm:px-3.5 sm:py-3.5 text-sm sm:text-[15px] text-[#22233A] outline-none placeholder:text-[#22233A]/40" />
				</label>

				<label class="font-sans font-semibold flex flex-col gap-1 sm:gap-1.5 text-xs sm:text-sm text-[#395B7A]">
					Servicio de interés:
					<select name="servicio" class="font-sans rounded-md border-[1.5px] border-[#395B7A]/25 bg-[#FEFEFE] px-3 py-2.5 sm:px-3.5 sm:py-3.5 text-sm sm:text-[15px] text-[#22233A] outline-none">
						<option>Mecánica de mantenimiento</option>
						<option>Mecánica de motor</option>
						<option>Inyección de gasolina</option>
						<option>Inyección diesel</option>
						<option>Electricidad/Electrónica</option>
						<option>Encendido</option>
						<option>Frenos, ABS, ESP</option>
						<option>Sistemas de refrigeración</option>
						<option>Neumáticos y alineación</option>
						<option>Aire acondicionado</option>
						<option>Vehículos híbridos</option>
						<option>Pre-ITV</option>
						<option>Otro</option>
					</select>
				</label>

				<label class="font-sans font-semibold flex flex-col gap-1 sm:gap-1.5 text-xs sm:text-sm text-[#395B7A]">
					Mensaje:
					<textarea rows="3" name="mensaje" placeholder="Cuéntenos qué le ocurre a su vehículo..." class="font-sans resize-y rounded-md border-[1.5px] border-[#395B7A]/25 bg-[#FEFEFE] px-3 py-2.5 sm:px-3.5 sm:py-3.5 text-sm sm:text-[15px] text-[#22233A] outline-none placeholder:text-[#22233A]/40"></textarea>
				</label>

				<button type="submit" class="btn-primary w-full sm:w-[40%] self-center cursor-pointer border-none text-sm sm:text-sm">Enviar Solicitud</button>
				<p class="text-center text-[10px] sm:text-xs text-[#395B7A]/75">Al enviar acepta que le contactemos para gestionar su solicitud.</p>
			</form>
		</div>
	</div>
</div>
