---
import Layout from '../layouts/Layout.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import FindUs from '../components/FindUs.astro';
import BrandsSlider from '../components/BrandsSlider.astro';
import Reviews from '../components/Reviews.astro';
import Contact from '../components/Contact.astro';
---

<Layout>

	<section id="inicio" class="grid items-stretch bg-[#22233A] lg:grid-cols-[42fr_58fr] mb-6">
		<div class="flex flex-col justify-center gap-6 px-6 py-18 md:px-14 lg:px-20">
			<h1 class="hero-title">
				Talleres C.O.D.A<br />
				<span class="text-[#66bbfe]">Valencia</span>
			</h1>

			<p class="max-w-120 text-lg leading-relaxed text-[#FEFEFE]/82">
				Más de dos décadas reparando y manteniendo vehículos en Valencia. Diagnóstico preciso, mecánicos certificados y trato honesto en cada visita.
			</p>
			<div class="hero-badge">
				<span class="h-2 w-2 rounded-full bg-[#66bbfe]"></span>
				<span class="hero-badge-text">
					Valencia · Marqués de San Juan, 8
				</span>
			</div>

			<div class="flex flex-wrap gap-6">
				<a href="/#contacto" class="btn-primary text-sm shadow-[0_8px_24px_rgba(128,26,11,0.35)]">
					Pedir Cita Previa
				</a>
				<a href="/#servicios" class="btn-outline">
					Ver Servicios
				</a>
			</div>
		</div>

		<div class="relative hidden overflow-hidden lg:block">
			<img src="/fachada-intro.png" alt="Fachada de Talleres C.O.D.A." class="h-full w-full object-cover object-center" />
			<div class="hero-image-overlay"></div>
		</div>
	</section>

	<section id="servicios" class="section-style">
		<div class="mb-14 text-center">
			<div class="section-eyebrow">Nuestros Servicios</div>
			<h2 class="section-title">Todo lo que su vehículo necesita</h2>
		</div>

		<ServicesGrid />

		<div class="mt-24 mb-14 text-center">
			<div class="section-eyebrow">Taller Multimarca</div>
			<p class="section-title text-sm sm:text-base lg:text-lg">
				Ofrecemos nuestros servicios para todo tipo de marcas, sea cual sea el modelo de su vehículo.
			</p>
		</div>
		<BrandsSlider />
	</section>

	<section id="encuentranos" class="section-style bg-linear-to-b from-[#FEFEFE] to-[#66bbfe]/25">
		<FindUs />
		<Reviews />
	</section>

	<section id="contacto" class="section-style bg-[#22233A]">
		<Contact />
	</section>

</Layout>