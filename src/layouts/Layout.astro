---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="es" class="min-h-full">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon-coda.png" />
		<meta name="generator" content={Astro.generator} />
		<title>Talleres CODA Valencia</title>
	</head>
	<body class="flex min-h-full flex-col font-sans">

		<header class="site-header">
			<a href="/" class="shrink-0">
				<img src="/logo-coda.png" alt="Talleres Coda" class="h-28 w-auto object-contain" />
			</a>

			<nav>
				<ul class="flex items-center gap-12 list-none">
					<li><a href="/#inicio" class="header-nav-link">Conócenos</a></li>
					<li><a href="/#servicios" class="header-nav-link">Nuestros Servicios</a></li>
					<li><a href="/#encuentranos" class="header-nav-link">Encuéntranos</a></li>
					<li><a href="/#contacto" class="header-nav-link">Contacto</a></li>
				</ul>
			</nav>

			<div class="flex items-center gap-8">
				<a href="tel:963474751" class="flex items-center gap-2 no-underline text-[#22233A]  hover:scale-[1.04] transition-transform duration-200 ">
					<img src="/icons/phone.svg" alt="" class="h-5 w-5" />
					<span class="font-semibold whitespace-nowrap">963 47 47 51</span>
				</a>
				<a href="/#contacto" class="btn-primary">Reservar Cita</a>
			</div>
		</header>

		<main class="flex-1">
			<slot />
		</main>

		<Footer />

		<script>
			const header = document.querySelector<HTMLElement>('.site-header');
			let lastY = window.scrollY;
			let ticking = false;

			window.addEventListener('scroll', () => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(() => {
					const currentY = window.scrollY;
					if (currentY > lastY && currentY > 100) {
						header?.classList.add('header-hidden');
					} else if (currentY < lastY) {
						header?.classList.remove('header-hidden');
					}
					lastY = currentY;
					ticking = false;
				});
			}, { passive: true });
		</script>
	</body>
</html>

