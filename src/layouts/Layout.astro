---
import '../styles/global.css';
---

<!doctype html>
<html lang="es" class="h-full">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Talleres-Coda-Valencia</title>
	</head>
	<body class="flex flex-col h-full font-sans">

		<header class="site-header">
			<a href="/" class="shrink-0">
				<img src="/logo-coda2.png" alt="Talleres Coda" class="h-28 w-auto object-contain" />
			</a>

			<nav>
				<ul class="flex items-center gap-12 list-none">
					<li><a href="/#inicio" class="header-nav-link">Conócenos</a></li>
					<li><a href="/#servicios" class="header-nav-link">Nuestros Servicios</a></li>
					<li><a href="/#encuentranos" class="header-nav-link">Encuéntranos</a></li>
					<li><a href="/#contacto" class="header-nav-link">Contacto</a></li>
				</ul>
			</nav>

			<div class="flex items-center gap-8">
				<a href="tel:963474751" class="flex items-center gap-2 no-underline text-[#22233A]  hover:scale-[1.04] transition-transform duration-200 ">
					<img src="/icons/phone.svg" alt="" class="h-5 w-5" />
					<span class="font-semibold whitespace-nowrap">963 47 47 51</span>
				</a>
				<a href="/#contacto" class="btn-primary">Reservar Cita</a>
			</div>
		</header>

		<main class="flex-1">
			<slot />
		</main>

		<footer class="flex flex-col items-center gap-4 px-32 py-8 bg-[#395B7A] border-t-4 border-[#801A0B]">
			<img src="/logo-coda2.png" alt="Talleres Coda" class="h-12 w-auto" />

			<nav>
				<ul class="flex gap-6 list-none m-0 p-0">
					<li><a href="/conocenos" class="footer-nav-link">Conócenos</a></li>
					<li><a href="/servicios" class="footer-nav-link">Nuestros servicios</a></li>
					<li><a href="/encuentranos" class="footer-nav-link">Encuéntranos</a></li>
					<li><a href="/contacto" class="footer-nav-link">Contacto</a></li>
				</ul>
			</nav>

			<p class="text-sm text-[#FEFEFE]/60 m-0">© 2026 Talleres Coda. Todos los derechos reservados.</p>
		</footer>
	</body>
</html>

